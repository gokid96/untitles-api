# Cloudflare terminates HTTPS for the API hostname. The cloudflared container forwards plain
# HTTP to this server over the compose network; nothing here is published on a host port.
{
	servers {
		# cloudflared connects from a private compose address. Trusting private ranges keeps the
		# X-Forwarded-Proto/-For values Cloudflare set (Spring needs https to build the OAuth
		# redirect_uri); otherwise Caddy would replace them with http and cloudflared's address.
		# X-Forwarded-Host is not taken from the request: see reverse_proxy below.
		trusted_proxies static private_ranges
		trusted_proxies_strict
		# Client IP in Caddy's logs: Cloudflare sets Cf-Connecting-Ip to the visitor's address.
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

:80 {
	encode zstd gzip

	# Realtime note editing (Hocuspocus WebSocket server). The web/app client connects to
	# wss://<API hostname>/collab; Cloudflare and cloudflared pass WebSocket upgrades through.
	handle /collab* {
		reverse_proxy collab:1234
	}

	handle {
		# Actuator stays internal (M12). The deploy health check calls
		# http://api:8070/actuator/health over the compose network instead.
		# /internal is the API used only by the collab container over the compose network.
		@internal path /actuator* /internal*
		respond @internal 404

		reverse_proxy api:8070 {
			# Cloudflare and the trusted cloudflared pass a visitor's X-Forwarded-Host on unchanged. Spring
			# builds absolute URLs from it, so pin it to the Host, which the tunnel route sets to the API hostname.
			# Caddy warns that this line is unnecessary; that holds only without trusted_proxies.
			header_up X-Forwarded-Host {host}
		}
	}
}
